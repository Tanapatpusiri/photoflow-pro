{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}]},
    {"source": "/football-gallery", "headers": [{"key": "X-Frame-Options", "value": "DENY"}, {"key": "Content-Security-Policy", "value": "frame-ancestors 'none'"}]},
    {"source": "/football-gallery/(.*)", "headers": [{"key": "X-Frame-Options", "value": "DENY"}, {"key": "Content-Security-Policy", "value": "frame-ancestors 'none'"}]}
  ]
}
